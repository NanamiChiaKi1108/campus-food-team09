r:#aa9c88;line-height:2;background:#fff;border-radius:20rpx}.owner{font-size:20rpx;color:#b7ab9a;margin-top:38rpx}.field{margin-bottom:25rpx}.field-title{display:block;font-size:25rpx;margin-bottom:12rpx}input,textarea,picker{background:#f8f5ef;border:1rpx solid #e8e0d2;padding:20rpx;border-radius:13rpx;font-size:25rpx;width:100%;line-height:1.6}input{height:85rpx}textarea{height:170rpx}.record{border-top:1rpx solid #eee7db;padding:25rpx 0;line-height:1.9}.record:first-child{border-top:0}.stars{font-size:40rpx;color:#e58b45;margin:20rpx 0}.images{display:flex;gap:12rpx;margin:18rpx 0;flex-wrap:wrap}.images image{width:150rpx;height:150rpx;border-radius:13rpx}.badge{font-size:20rpx;background:#f1e8d7;color:#97744b;padding:7rpx 14rpx;border-radius:20rpx}.stats{display:flex;justify-content:space-around;margin-top:25rpx}.stats view{text-align:center;font-size:22rpx;color:#928571}.stats text{display:block;color:#40372b;font-size:39rpx;font-weight:600}.divider{height:1rpx;background:#eee7db;margin:25rpx 0}.rank-number{font-size:35rpx;color:#db764c;width:55rpx}.grow{flex:1}.wheel{width:400rpx;height:400rpx;border-radius:50%;border:17rpx solid #fff;background:conic-gradient(#e9b67e 0 60deg,#f4dfbb 60deg 120deg,#e99c78 120deg 180deg,#f8dfb1 180deg 240deg,#f1c2a0 240deg 300deg,#f1d4ac 300deg);box-shadow:0 10rpx 40rpx #b691502b;margin:25rpx auto;display:flex;align-items:center;justify-content:center;transition:transform 2.4s cubic-bezier(.16,.8,.24,1)}.wheel-center{background:#fff9ef;width:145rpx;height:145rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:60rpx}.center{text-align:center}.big-emoji{font-size:110rpx}.notice{font-size:22rpx;color:#a09077;line-height:1.9;margin:20rpx 0}.mt{margin-top:25rpx}.block{display:block}.check-label{display:flex;align-items:center;gap:5rpx;font-size:24rpx;padding:10rpx 0}
