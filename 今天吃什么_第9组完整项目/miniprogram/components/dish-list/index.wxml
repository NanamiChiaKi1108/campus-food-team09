<view class="grid"><view wx:for="{{items}}" wx:key="id" class="dish"><view class="dish-art" data-id="{{item.id}}" bindtap="open">{{item.emoji}}</view><view class="dish-info"><view class="row"><view class="dish-name" data-id="{{item.id}}" bindtap="open">{{item.name}}</view><text class="price">¥{{item.price}}</text></view><view class="muted">{{item.canteenName}} · {{item.windowName}}</view><view class="tags">{{item.taste}} · {{item.spiceLabel}} · {{item.diet}}</view><view class="row mt"><text class="status l{{item.crowd.level}}">{{item.crowd.label}}</text><button class="small" data-id="{{item.id}}" catchtap="favorite">{{item.favorite ? '♥' : '♡'}}</button></view></view></view></view><view wx:if="{{!items.length}}" class="empty">没有符合条件的菜品，请放宽筛选</view>
