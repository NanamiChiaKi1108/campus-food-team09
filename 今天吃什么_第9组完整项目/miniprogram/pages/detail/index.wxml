<view class="page"><block wx:if="{{dish}}"><view class="hero center"><view class="big-emoji">{{dish.emoji}}</view></view><view class="row"><view class="title">{{dish.name}}</view><text class="price">¥{{dish.price}}</text></view><view class="muted">{{dish.canteenName}} · {{dish.windowName}} · ★ {{dish.rating}}</view><view class="tags">{{dish.taste}} · {{dish.spiceLabel}} · {{dish.diet}} · {{dish.available?'在售':'已下架'}}</view><view class="panel">{{dish.description}}<view class="notice">食材标签：{{dish.allergens.length?dish.allergens:'未标注常见过敏原'}}。食材可能变化，请向窗口确认。</view><button class="primary" bindtap="favorite">{{dish.favorite?'♥ 已收藏':'♡ 收藏这道菜'}}</button><view class="wrap mt"><button class="small" bindtap="plan" disabled="{{!dish.available}}">安排到就餐日历</button><button class="small" bindtap="compare">加入菜品对比</button></view></view><view class="panel"><view class="section-title">{{editingId?'修改我的评价':'说说这道菜'}}</view><view wx:if="{{editingId}}" class="notice">保留原图片，修改后会重新进入审核。<button class="small" bindtap="cancelEdit">取消修改</button></view><view class="stars"><text wx:for="{{stars}}" wx:key="*this" data-n="{{item}}" bindtap="star">{{item<=rating?'★':'☆'}} </text></view><textarea placeholder="分享味道 分量和体验（5–300字）" value="{{text}}" maxlength="300" disabled="{{submitting}}" bindinput="input"/><view class="images"><view wx:for="{{images}}" wx:key="*this"><image src="{{item}}" mode="aspectFill"/><button class="small" data-i="{{index}}" bindtap="removeImage">移除</button></view></view><button class="small mt" disabled="{{editingId||submitting}}" bindtap="choose">选择图片 最多3张</button><view class="notice">图片每张1MB以内。评价和图片通过审核后公开。</view><button class="primary" bindtap="submit" loading="{{submitting}}" disabled="{{submitting||(!dish.available&&!editingId)}}">{{editingId?'保存并重新送审':'提交评价'}}</button></view><view class="section-title">食客评价</view><picker range="{{reviewSorts}}" value="{{reviewSort}}" bindchange="sort">{{reviewSorts[reviewSort]}}</picker><view class="panel"><view class="record" wx:for="{{reviews}}" wx:key="id"><view class="row"><text>{{item.author}}</text><text>{{item.rating}} 星 · {{item.statusText}}</text></view><view>{{item.text}}</view><view class="images"><image wx:for="{{item.images}}" wx:for-item="src" wx:key="*this" src="{{src}}" mode="aspectFill" data-src="{{src}}" data-urls="{{item.images}}" bindtap="preview"/></view><view class="muted">{{item.date}} {{item.reason}}</view><view wx:if="{{item.imageNotice}}" class="notice">{{item.imageNotice}}</view><button wx:if="{{item.mine}}" class="small" data-id="{{item.id}}" bindtap="edit">修改评价</button><button wx:if="{{item.mine}}" class="small" data-id="{{item.id}}" bindtap="remove">删除我的评价</button><button wx:elif="{{item.status==='approved'}}" class="small" data-id="{{item.id}}" bindtap="report">举报</button></view><view wx:if="{{!reviews.length}}" class="muted">还没有评价，来留下第一条吧。</view></view></block><view wx:else class="empty">菜品不存在或尚未加载</view><view class="owner">模块负责人 · 李付远</view></view>
