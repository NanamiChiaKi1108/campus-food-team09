<view class="page"><view class="eyebrow">CAMPUS CONTENT MANAGEMENT</view><view class="title">管理工作台</view>
<view wx:if="{{!allowed}}" class="panel"><view class="notice">{{demo?'本地演示权限仅影响本机。云端管理员由服务端白名单配置。':'你没有管理权限，请联系项目管理员。'}}</view><button wx:if="{{demo}}" class="primary" bindtap="demoLogin">进入本地演示管理台</button></view>
<block wx:else><button wx:if="{{!demo}}" class="small mt" bindtap="upgradeCampus">升级旧版五餐厅目录</button><view class="panel stats"><view><text>{{pendingCount}}</text>待审核</view><view><text>{{reportCount}}</text>待处理举报</view><view><text>{{activeCount}}</text>在售菜品</view></view><view class="panel"><view class="section-title">食堂数据概览</view><view class="notice">待审含图评价 {{overview.pendingImages}} 条 · 公开评价 {{overview.approved}} 条</view><view class="record" wx:for="{{overview.canteens}}" wx:key="id"><view class="row"><text>{{item.name}}</text><text class="status l{{item.crowd.level}}">{{item.crowd.label}}</text></view><view class="muted">{{item.windows}}个窗口 · {{item.dishes}}道在售 · {{item.reviews}}条评价 · 均分{{item.score}}</view></view></view><view class="chips"><view wx:for="{{tabs}}" wx:key="id" class="chip {{tab===item.id?'on':''}}" data-id="{{item.id}}" bindtap="tab">{{item.name}}</view></view>
<view wx:if="{{editing}}" class="panel"><view class="field"><text class="field-title">名称</text><input value="{{form.name}}" data-key="name" bindinput="input" maxlength="30"/></view>
<block wx:if="{{tab==='dishes'}}"><view class="field"><text class="field-title">所属窗口</text><picker range="{{windowLabels}}" value="{{windowIndex}}" data-field="windowIndex" bindchange="picker">{{windowLabels[windowIndex]}}</picker></view><view class="field"><text class="field-title">价格 元</text><input type="digit" value="{{form.priceYuan}}" data-key="priceYuan" bindinput="input"/></view><view class="field"><text class="field-title">口味</text><picker range="{{tastes}}" value="{{tasteIndex}}" data-field="tasteIndex" bindchange="picker">{{tastes[tasteIndex]}}</picker></view><view class="field"><text class="field-title">荤素</text><picker range="{{diets}}" value="{{dietIndex}}" data-field="dietIndex" bindchange="picker">{{diets[dietIndex]}}</picker></view><view class="field"><text class="field-title">辣度</text><picker range="{{spices}}" value="{{spiceIndex}}" data-field="spiceIndex" bindchange="picker">{{spices[spiceIndex]}}</picker></view><view class="field"><text class="field-title">菜品介绍</text><textarea value="{{form.description}}" data-key="description" bindinput="input" maxlength="300"/></view><view class="field"><text class="field-title">食材标签 用顿号分隔</text><input value="{{form.allergensText}}" data-key="allergensText" bindinput="input"/></view><view class="field row"><text>是否在售</text><switch checked="{{form.available}}" bindchange="available" color="#e45d3b"/></view></block>
<block wx:elif="{{tab==='windows'}}"><view class="field"><text class="field-title">所属食堂</text><picker range="{{canteenLabels}}" value="{{canteenIndex}}" data-field="canteenIndex" bindchange="picker">{{canteenLabels[canteenIndex]}}</picker></view><view class="field"><text class="field-title">楼层和窗口号</text><input value="{{form.floor}}" data-key="floor" bindinput="input" maxlength="50"/></view><view class="field"><text class="field-title">营业时间</text><input value="{{form.hours}}" data-key="hours" bindinput="input" maxlength="50"/></view></block>
<block wx:else><view class="field"><text class="field-title">位置</text><input value="{{form.location}}" data-key="location" bindinput="input" maxlength="50"/></view><view class="field"><text class="field-title">营业时间</text><input value="{{form.hours}}" data-key="hours" bindinput="input" maxlength="50"/></view><view class="field"><text class="field-title">简介</text><input value="{{form.note}}" data-key="note" bindinput="input" maxlength="120"/></view></block>
<view class="wrap"><button class="primary" bindtap="save" loading="{{saving}}" disabled="{{saving}}">保存</button><button bindtap="close">取消</button></view></view>
<block wx:else><input value="{{query}}" bindinput="search" placeholder="搜索名称、编号或评价内容" maxlength="80"/><view wx:if="{{tab==='reviews'||tab==='reports'}}" class="chips"><button class="small" data-id="all" bindtap="status">全部</button><button class="small" data-id="pending" bindtap="status">仅待处理</button></view><button wx:if="{{tab!=='reviews'&&tab!=='reports'&&tab!=='audit'}}" class="primary mt" data-id="" bindtap="edit">新增目录</button><view class="panel"><view class="record" wx:for="{{records}}" wx:key="id"><block wx:if="{{tab==='reviews'}}"><view class="row"><text>{{item.author}} · {{item.rating}}星</text><text class="badge">{{item.status}}</text></view><view>{{item.text}}</view><view class="images"><image wx:for="{{item.images}}" wx:for-item="src" wx:key="*this" src="{{src}}" mode="aspectFill" data-src="{{src}}" data-urls="{{item.images}}" bindtap="preview"/></view><view class="wrap"><button class="small" data-id="{{item.id}}" data-status="approved" bindtap="moderate" disabled="{{item.status==='approved'}}">审核通过</button><button class="small danger" data-id="{{item.id}}" data-status="rejected" bindtap="moderate" disabled="{{item.status==='rejected'}}">拒绝</button></view></block><block wx:elif="{{tab==='reports'}}"><view>{{item.reviewText}}</view><view>{{item.reason}} · {{item.status}}</view><view class="wrap mt" wx:if="{{item.status==='pending'}}"><button class="small danger" data-id="{{item.id}}" data-decision="hide" bindtap="resolve">隐藏评价</button><button class="small" data-id="{{item.id}}" data-decision="dismiss" bindtap="resolve">驳回</button></view></block><block wx:elif="{{tab==='audit'}}"><view>{{item.action==='saveCatalog'?'目录维护':item.action==='moderate'?'评价审核':'举报处理'}}</view><view class="muted">对象 {{item.targetId}} · {{item.date}}</view></block><block wx:else><view class="row"><view>{{item.name}}<view class="muted">{{item.id}}</view></view><button class="small" data-id="{{item.id}}" bindtap="edit">编辑</button></view></block></view><view wx:if="{{!records.length}}" class="muted">暂无记录</view></view></block></block><view class="owner">模块负责人 · 王俊杰</view></view>
