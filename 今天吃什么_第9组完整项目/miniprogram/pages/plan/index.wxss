.budget-hero{background:#214e43;color:#fff;padding:36rpx;border-radius:30rpx;margin-top:30rpx}.budget-hero .muted{color:#d8e5df}.budget-hero .eyebrow{color:#a9c9a6}.budget-total{font-size:65rpx;font-weight:700;margin:15rpx 0}.progress-track{height:12rpx;background:#ffffff22;border-radius:10rpx;overflow:hidden;margin:20rpx 0}.progress-fill{height:100%;background:#efc07d}.week-bars{display:flex;justify-content:space-between;gap:10rpx}.day-bar{flex:1;text-align:center;font-size:18rpx;color:#8f8575}.bar-area{height:150rpx;display:flex;align-items:flex-end;justify-content:center;margin:15rpx 0}.bar{width:27rpx;background:#ec9d62;border-radius:8rpx 8rpx 0 0}.row input{flex:1;width:160rpx}.row .small{flex-shrink:0}
